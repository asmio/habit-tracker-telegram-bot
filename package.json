{
  "name": "habit-tracker-telegram-bot",
  "version": "1.0.0",
  "description": "Telegram bot for tracking habits",
  "private": true,
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.46.0",
    "node-cron": "^4.6.0",
    "tz-lookup": "^6.1.25",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/tz-lookup": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
